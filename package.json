{
  "name": "@opensubtitles/mcp-server",
  "version": "2.0.3",
  "description": "Official OpenSubtitles MCP server: search, inspect and download subtitles from AI agents (stdio and Streamable HTTP).",
  "mcpName": "com.opensubtitles/mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server": "dist/index.js",
    "opensubtitles-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js --http",
    "start:stdio": "node dist/index.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "smoke:inspector": "bash scripts/inspector-smoke.sh",
    "prepublishOnly": "npm run build",
    "test:unit": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "subtitles",
    "opensubtitles",
    "srt",
    "ai-agent",
    "claude"
  ],
  "author": "OpenSubtitles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensubtitles/mcp.opensubtitles.com.git"
  },
  "homepage": "https://mcp.opensubtitles.com",
  "bugs": {
    "url": "https://github.com/opensubtitles/mcp.opensubtitles.com/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "guessit-js": "^5.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
